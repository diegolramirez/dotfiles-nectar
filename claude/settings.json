{
  "agentPushNotifEnabled": true,
  "effortLevel": "medium",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "env": {
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "10",
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "2",
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "hooks": {
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "jq -r '.tool_input.command // \"\"' | grep -qi 'co-authored-by' && { echo 'Blocked: no Co-Authored-By or other attribution trailer in commits.' >&2; exit 2; } || exit 0",
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "model": "opus[1m]",
  "modelSettings": {
    "claude-haiku-5-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    },
    "claude-sonnet-5-5": {
      "effortLevel": "high"
    }
  },
  "remoteControlAtStartup": false,
  "theme": "dark"
}
